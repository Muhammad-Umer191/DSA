# Build files and artifacts
*.o
*.obj
*.out
*.exe
*.dll
*.so
*.dylib
*.a
*.dSYM/

# CMake & Make
CMakeFiles/
CMakeCache.txt
cmake-build-*/
Makefile
compile_commands.json

# IDE / Editor files
.vscode/
.idea/
*.code-workspace

# OS & Temporary files
.DS_Store
Thumbs.db
*.tmp
*.temp
*.swp
*.swo

# Local environment files
.env

# Linux Extensionless Executables
# Option A: Ignore the dedicated output directories (Recommended)
/build/
/bin/

# Ignore all files inside subdirectories by default
**/*

# Allow Git to look inside subdirectories
!**/

# Whitelist your source code, files, and project documents
!**/README.md
!**/*.cpp
!**/*.h
!**/*.hpp
!**/*.txt

# Make sure git keeps tracking your main config files
!.gitignore
!Makefile
!CMakeLists.txt
